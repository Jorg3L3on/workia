  {
    "_meta": {
      "securitySchemes": [
        {
          "scopes": [
            "write:people",
          ],
          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Baja o reingreso",
    },
    "description": "Da de baja laboral o reingresa a una persona (estatus activa | baja). No es borrar: el expediente sigue ahí. Baja: fecha_baja, tipo_baja, motivo (motivo_id de list_termination_reasons, o su nombre en motivo) y recontratable son obligatorios; comentario y finiquito opcionales (el monto sólo con el scope pii y compensation:read). Cierra el periodo laboral y el contrato vigente queda «terminado» en la fecha de baja. Reingreso (status activa): abre un nuevo periodo en el mismo expediente con fecha_ingreso (por defecto hoy) y reconocer_antiguedad (por defecto false: la antigüedad reinicia). La vista previa avisa si tiene contrato vigente, activos en resguardo o si su última baja dice no recontratable. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "comentario": {
          "description": "Baja: texto libre.",
          "maxLength": 1000,
          "type": "string",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "fecha_antiguedad_reconocida": {
          "description": "Reingreso con reconocer_antiguedad: desde cuándo cuenta; vacío = el primer ingreso.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "fecha_baja": {
          "description": "Baja: fecha de baja (aaaa-mm-dd), no antes del ingreso.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "fecha_ingreso": {
          "description": "Reingreso: fecha de ingreso del nuevo periodo (aaaa-mm-dd); por defecto hoy.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "finiquito": {
          "description": "Baja: finiquito opcional; se puede actualizar después en la app.",
          "properties": {
            "estado": {
              "enum": [
                "pendiente",
                "pagado",
                "no_aplica",
              ],
              "type": "string",
            },
            "fecha": {
              "description": "Fecha del finiquito.",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string",
            },
            "monto": {
              "description": "Pesos. Sólo con el scope pii y compensation:read.",
              "maximum": 99999999.99,
              "minimum": 0,
              "type": "number",
            },
          },
          "type": "object",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "motivo": {
          "description": "Baja: nombre del motivo del catálogo, si no envías motivo_id. Un texto que no está en el catálogo es un error que lista los motivos.",
          "maxLength": 300,
          "type": "string",
        },
        "motivo_id": {
          "description": "Baja: id del motivo (list_termination_reasons).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "reconocer_antiguedad": {
          "default": false,
          "description": "Reingreso: true acumula la antigüedad de los periodos anteriores; false (por defecto) la reinicia.",
          "type": "boolean",
        },
        "recontratable": {
          "description": "Baja: obligatorio.",
          "type": "boolean",
        },
        "status": {
          "enum": [
            "activa",
            "baja",
          ],
          "type": "string",
        },
        "tipo_baja": {
          "description": "Baja: voluntaria, despido, termino_contrato u otra.",
          "enum": [
            "voluntaria",
            "despido",
            "termino_contrato",
            "otra",
          ],
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "status",
        "idempotency_key",
      ],
      "type": "object",
    },
    "name": "set_person_status",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "audit_event_ids": {
          "items": {
