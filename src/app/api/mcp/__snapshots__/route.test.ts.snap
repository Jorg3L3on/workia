          "type": "string",
        },
        "cursor": {
          "description": "Cursor opaco devuelto como next_cursor en la página anterior.",
          "maxLength": 1000,
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Cuántos resultados (por defecto 25, máximo 100).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "region_id": {
          "description": "Sólo personas de sucursales de esta región (list_regions).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "site_id": {
          "description": "Sólo personas de esta sucursal.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "within_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
