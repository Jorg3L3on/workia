  {
    "_meta": {
      "securitySchemes": [
        {
          "scopes": [
            "read",
          ],
          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Vista previa de contrato",
    },
    "description": "Simula la emisión de un contrato sin guardar nada: el texto que saldría, los tokens que quedarían vacíos (p. ej. persona sin horario, sin CURP o sin domicilio) y lo que impediría emitirlo (contrato vigente, falta fecha de fin). Con compensacion llena los tokens de salario. Sin el scope pii los identificadores salen enmascarados y el domicilio oculto; los montos de salario sólo salen con pii y compensation:read.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "compensacion": {
          "description": "Compensación que se congela en el contrato. Sólo con el scope pii y el permiso compensation:read. En renew_contract, si no se envía se conserva la del contrato anterior.",
          "properties": {
            "dia_pago": {
              "description": "Texto libre, p. ej. «15 y último».",
              "maxLength": 60,
              "type": "string",
            },
            "forma_pago": {
              "enum": [
                "transferencia",
                "efectivo",
                "cheque",
              ],
              "type": "string",
            },
            "periodicidad": {
              "enum": [
                "semanal",
                "quincenal",
                "mensual",
              ],
              "type": "string",
            },
            "salario_diario": {
              "description": "Salario diario en pesos; el mensual se calcula × 30.4.",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number",
            },
          },
          "required": [
            "salario_diario",
            "forma_pago",
            "periodicidad",
          ],
          "type": "object",
        },
        "end_date": {
          "description": "Fin (aaaa-mm-dd), obligatorio si es determinado.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "start_date": {
          "description": "Inicio (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "template_id": {
          "description": "Plantilla.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "type": {
          "enum": [
            "determinado",
            "indeterminado",
          ],
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "template_id",
        "type",
        "start_date",
      ],
      "type": "object",
    },
