      "readOnlyHint": false,
      "title": "Devolver activo",
    },
    "description": "Registra la devolución de un activo asignado, con fecha y la condición en que regresa (obligatoria). Queda «En almacén». CONFLICT si no está asignado. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "asset_id": {
          "description": "Activo.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "condition_note": {
          "description": "Condición al devolver.",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "movement_date": {
          "description": "Fecha de devolución (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "notes": {
          "maxLength": 500,
          "type": "string",
        },
      },
      "required": [
        "asset_id",
        "movement_date",
        "condition_note",
        "idempotency_key",
      ],
      "type": "object",
    },
