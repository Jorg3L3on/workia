  {
    "_meta": {
      "securitySchemes": [
        {
          "scopes": [
            "write:contracts",
          ],
          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Emitir contrato",
    },
    "description": "Emite un contrato con una plantilla: congela el texto y el horario de la persona al emitir, igual que la app. CONFLICT si ya tiene un contrato vigente. La vista previa dice qué datos quedarían vacíos en el texto. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "compensacion": {
          "description": "Compensación que se congela en el contrato. Sólo con el scope pii y el permiso compensation:read. En renew_contract, si no se envía se conserva la del contrato anterior.",
          "properties": {
            "dia_pago": {
              "description": "Texto libre, p. ej. «15 y último».",
              "maxLength": 60,
              "type": "string",
            },
            "forma_pago": {
              "enum": [
                "transferencia",
                "efectivo",
                "cheque",
              ],
              "type": "string",
            },
            "periodicidad": {
              "enum": [
                "semanal",
                "quincenal",
                "mensual",
              ],
              "type": "string",
            },
            "salario_diario": {
              "description": "Salario diario en pesos; el mensual se calcula × 30.4.",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number",
            },
          },
          "required": [
            "salario_diario",
            "forma_pago",
            "periodicidad",
          ],
          "type": "object",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "end_date": {
          "description": "Fin (aaaa-mm-dd); obligatorio si es determinado.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "notice_window": {
          "description": "Meses de aviso antes del fin para la bandeja, o no_avisar.",
          "enum": [
            "1",
            "2",
            "3",
            "6",
            "no_avisar",
          ],
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "start_date": {
          "description": "Inicio (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "template_id": {
          "description": "Plantilla.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "type": {
          "enum": [
            "determinado",
            "indeterminado",
          ],
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "type",
        "start_date",
        "notice_window",
        "template_id",
        "idempotency_key",
      ],
      "type": "object",
    },
    "name": "issue_contract",
