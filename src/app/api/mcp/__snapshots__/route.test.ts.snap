    "description": "Contratos filtrables por persona, estado, tipo y rango de fecha de fin, ordenados por fecha de fin (los indeterminados al final). Sin el texto del contrato (ver get_contract).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "cursor": {
          "description": "Cursor opaco devuelto como next_cursor en la página anterior.",
          "maxLength": 1000,
          "type": "string",
        },
        "end_date_from": {
          "description": "Fin desde (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "end_date_to": {
          "description": "Fin hasta (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Cuántos resultados (por defecto 25, máximo 100).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "person_id": {
          "description": "Sólo los contratos de esta persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "status": {
          "items": {
            "enum": [
              "vigente",
              "renovado",
              "no_renovado",
              "vencido",
            ],
            "type": "string",
          },
          "maxItems": 4,
          "type": "array",
        },
        "type": {
          "enum": [
            "determinado",
            "indeterminado",
          ],
          "type": "string",
        },
      },
      "type": "object",
    },
