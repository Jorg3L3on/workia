                "texto",
                "origen",
              ],
              "type": "object",
            },
            {
              "type": "null",
            },
          ],
        },
        "note": {
          "type": "string",
        },
        "person": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
            },
            "nombre_completo": {
              "type": "string",
            },
            "status": {
              "type": "string",
            },
            "url": {
              "type": "string",
            },
          },
          "required": [
            "id",
            "nombre_completo",
            "status",
            "url",
          ],
          "type": "object",
        },
        "preview": {
          "additionalProperties": false,
          "properties": {
            "details": {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "summary": {
              "type": "string",
            },
            "warnings": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "summary",
          ],
          "type": "object",
        },
        "status": {
          "description": "preview: nada se escribió todavía; done: el cambio quedó hecho.",
          "enum": [
