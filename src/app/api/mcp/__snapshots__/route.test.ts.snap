    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Crear en el catálogo",
    },
    "description": "Crea un área, un puesto, una actividad o una ubicación (sucursal o corporativo). CONFLICT si ya existe uno con el mismo nombre (sin importar mayúsculas, acentos ni espacios). site_kind es obligatorio para kind=site. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "area_id": {
          "description": "Área del puesto (kind=position).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "kind": {
          "enum": [
            "area",
            "position",
            "activity",
            "site",
          ],
          "type": "string",
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
        "parent_area_id": {
          "description": "Área padre (kind=area).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "site_kind": {
          "description": "Obligatorio para kind=site.",
          "enum": [
            "corporativo",
            "sucursal",
          ],
          "type": "string",
        },
      },
      "required": [
        "kind",
        "name",
        "idempotency_key",
      ],
      "type": "object",
    },
