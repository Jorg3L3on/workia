            },
            "periodicidad": {
              "enum": [
                "semanal",
                "quincenal",
                "mensual",
              ],
              "type": "string",
            },
            "salario_diario": {
              "description": "Salario diario en pesos; el mensual se calcula × 30.4.",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number",
            },
          },
          "required": [
            "salario_diario",
            "forma_pago",
            "periodicidad",
          ],
          "type": "object",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "contract_id": {
          "description": "Contrato vigente a renovar.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "end_date": {
          "description": "Fin (aaaa-mm-dd); obligatorio si es determinado.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "notice_window": {
          "description": "Meses de aviso antes del fin para la bandeja, o no_avisar.",
          "enum": [
            "1",
            "2",
            "3",
            "6",
            "no_avisar",
          ],
          "type": "string",
        },
        "start_date": {
          "description": "Inicio (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "template_id": {
          "description": "Plantilla.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "type": {
          "enum": [
            "determinado",
            "indeterminado",
          ],
          "type": "string",
        },
      },
      "required": [
        "contract_id",
        "type",
        "start_date",
        "notice_window",
        "template_id",
        "idempotency_key",
      ],
      "type": "object",
    },
