          "type": "string",
        },
        "horario_bloques": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "bloques": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "comida": {
                        "anyOf": [
