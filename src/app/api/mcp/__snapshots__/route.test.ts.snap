      "readOnlyHint": true,
      "title": "Vista previa de contrato",
    },
    "description": "Simula la emisión de un contrato sin guardar nada: el texto que saldría, los tokens que quedarían vacíos (p. ej. persona sin horario o sin RFC) y lo que impediría emitirlo (contrato vigente, falta fecha de fin). El RFC del texto sale enmascarado sin el scope pii.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "end_date": {
          "description": "Fin (aaaa-mm-dd), obligatorio si es determinado.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "start_date": {
          "description": "Inicio (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "template_id": {
          "description": "Plantilla.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "type": {
          "enum": [
            "determinado",
            "indeterminado",
          ],
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "template_id",
        "type",
        "start_date",
      ],
      "type": "object",
    },
