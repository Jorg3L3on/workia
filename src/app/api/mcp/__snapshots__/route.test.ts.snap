    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Cambiar horario",
    },
    "description": "Obsoleta: usa update_person_schedule_blocks (horario por bloques, día de descanso). Captura un horario simple de lunes a viernes (HH:mm) y reemplaza los bloques. Los campos que no envíes quedan vacíos. No cambia contratos ya emitidos: conservan el horario con que se firmaron. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "entrada": {
          "description": "Entrada.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "regreso_comer": {
          "description": "Regreso de comer.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string",
        },
        "salida": {
          "description": "Salida.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string",
        },
        "salida_comer": {
          "description": "Salida a comer.",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "idempotency_key",
      ],
      "type": "object",
    },
