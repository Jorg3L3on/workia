        },
        "expires_at": {
          "type": "string",
        },
        "expires_at_mx": {
          "type": "string",
        },
        "person": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
            },
            "nombre_completo": {
              "type": "string",
            },
            "status": {
