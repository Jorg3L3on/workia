            "status",
            "url",
          ],
          "type": "object",
        },
        "preview": {
          "additionalProperties": false,
          "properties": {
            "details": {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "summary": {
              "type": "string",
            },
            "warnings": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "summary",
          ],
          "type": "object",
        },
        "status": {
          "description": "preview: nada se escribió todavía; done: el cambio quedó hecho.",
          "enum": [
            "preview",
            "done",
          ],
          "type": "string",
        },
        "warnings": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "status",
      ],
      "type": "object",
    },
    "title": "Baja o reingreso",
  },
  {
