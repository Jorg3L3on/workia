          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "bloques": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "comida": {
                        "anyOf": [
                          {
                            "additionalProperties": false,
                            "properties": {
                              "fin": {
                                "type": "string",
                              },
                              "inicio": {
                                "type": "string",
                              },
                            },
                            "required": [
                              "inicio",
                              "fin",
                            ],
                            "type": "object",
                          },
                          {
                            "type": "null",
                          },
                        ],
                      },
                      "dias": {
                        "items": {
                          "type": "string",
                        },
                        "type": "array",
                      },
                      "entrada": {
                        "type": "string",
                      },
                      "salida": {
                        "type": "string",
                      },
                    },
                    "required": [
                      "dias",
                      "entrada",
                      "salida",
                      "comida",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "dia_descanso": {
                  "anyOf": [
                    {
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "origen": {
                  "description": "simple: horario anterior leído como un bloque L–V.",
                  "enum": [
                    "bloques",
                    "simple",
                  ],
                  "type": "string",
                },
                "texto": {
                  "type": "string",
