          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Cambiar horario por bloques",
    },
    "description": "Captura el horario por bloques de una persona: cada bloque con días (lun…dom), entrada, salida y comida opcional, más el día de descanso. Reemplaza el horario completo (lista vacía lo borra). La vista previa muestra el texto, p. ej. «L–V 08:00–17:00 (comida 13:00–14:00) · Sáb 08:00–13:00 · Descanso dom». No cambia contratos ya emitidos. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "bloques": {
          "description": "Bloques de días con su horario. Un día no puede estar en dos bloques ni ser el de descanso. Lista vacía borra el horario.",
          "items": {
            "properties": {
              "comida": {
                "description": "Comida dentro del horario; omítela si no hay.",
                "properties": {
                  "fin": {
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "type": "string",
                  },
                  "inicio": {
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                    "type": "string",
                  },
                },
                "required": [
                  "inicio",
                  "fin",
                ],
                "type": "object",
              },
              "dias": {
                "items": {
                  "enum": [
                    "lun",
                    "mar",
                    "mie",
                    "jue",
                    "vie",
                    "sab",
                    "dom",
                  ],
                  "type": "string",
                },
                "minItems": 1,
                "type": "array",
              },
              "entrada": {
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "type": "string",
              },
              "salida": {
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
                "type": "string",
              },
            },
            "required": [
              "dias",
              "entrada",
              "salida",
            ],
            "type": "object",
          },
          "maxItems": 7,
          "type": "array",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "dia_descanso": {
          "anyOf": [
            {
              "enum": [
                "lun",
                "mar",
                "mie",
                "jue",
                "vie",
                "sab",
                "dom",
              ],
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Día de descanso (lun…dom).",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "bloques",
        "idempotency_key",
      ],
      "type": "object",
    },
    "name": "update_person_schedule_blocks",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "audit_event_ids": {
          "items": {
