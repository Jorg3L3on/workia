  {
    "_meta": {
      "securitySchemes": [
        {
          "scopes": [
            "write:contracts",
          ],
          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Decidir renovación",
    },
    "description": "La decisión de la bandeja de renovación en un paso, igual que la app: renovar_indeterminado, renovar_determinado (con end_date) o no_renovar (motivo obligatorio). Al renovar puede cambiar el puesto (new_position_id) y la compensación (sin compensacion conserva la anterior). Nunca cambia la fecha de ingreso. Tras renovar a indeterminado avisa que la constancia de antigüedad está disponible. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "compensacion": {
          "description": "Compensación que se congela en el contrato. Sólo con el scope pii y el permiso compensation:read. En renew_contract, si no se envía se conserva la del contrato anterior.",
          "properties": {
            "dia_pago": {
              "description": "Texto libre, p. ej. «15 y último».",
              "maxLength": 60,
              "type": "string",
            },
            "forma_pago": {
              "enum": [
                "transferencia",
                "efectivo",
                "cheque",
              ],
              "type": "string",
            },
            "periodicidad": {
              "enum": [
                "semanal",
                "quincenal",
                "mensual",
              ],
              "type": "string",
            },
            "salario_diario": {
              "description": "Salario diario en pesos; el mensual se calcula × 30.4.",
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number",
            },
          },
          "required": [
            "salario_diario",
            "forma_pago",
            "periodicidad",
          ],
          "type": "object",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "contract_id": {
          "description": "Contrato vigente.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "decision": {
          "enum": [
            "renovar_indeterminado",
            "renovar_determinado",
            "no_renovar",
          ],
          "type": "string",
        },
        "end_date": {
          "description": "Fin (obligatorio en renovar_determinado).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "motivo": {
          "description": "Obligatorio en no_renovar.",
          "maxLength": 500,
          "type": "string",
        },
        "new_position_id": {
          "description": "Nuevo puesto (opcional).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "notice_window": {
          "enum": [
            "1",
            "2",
            "3",
            "6",
            "no_avisar",
          ],
          "type": "string",
        },
        "start_date": {
          "description": "Inicio del nuevo contrato; por defecto el fin del actual.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "template_id": {
          "description": "Plantilla del nuevo contrato (al renovar).",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "required": [
        "contract_id",
        "decision",
        "idempotency_key",
      ],
      "type": "object",
    },
