    "description": "«¿Qué contratos vencen en N días?»: contratos determinados vigentes cuya fecha de fin cae entre hoy (México) y hoy + within_days, sin importar el aviso. Incluye días restantes y si ya están en la bandeja de renovación.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "area_id": {
          "description": "Sólo personas de esta área.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "cursor": {
          "description": "Cursor opaco devuelto como next_cursor en la página anterior.",
          "maxLength": 1000,
          "type": "string",
        },
        "limit": {
          "default": 25,
          "description": "Cuántos resultados (por defecto 25, máximo 100).",
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
        },
        "site_id": {
          "description": "Sólo personas de esta sucursal.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "within_days": {
          "default": 30,
          "maximum": 365,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
