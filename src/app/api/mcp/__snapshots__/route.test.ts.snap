    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
      "title": "Derecho a vacaciones",
    },
    "description": "Derecho a vacaciones de una persona, el mismo que muestra la tarjeta Vacaciones del expediente: año de servicio cumplido, aniversario actual y siguiente, días de derecho y fecha límite para otorgarlas. Con menos de un año de servicio no hay días ni fecha límite. Si la fecha de antigüedad es posterior a la de cálculo, la antigüedad aún no inicia. No incluye días tomados ni saldo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "person_id": {
          "description": "Id de la persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "required": [
        "person_id",
      ],
      "type": "object",
    },
    "name": "get_vacation_entitlement",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "as_of_mx": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "closed": {
          "description": "true cuando el periodo laboral está cerrado.",
          "type": "boolean",
        },
        "current_anniversary": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "current_anniversary_mx": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "entitlement_days": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
        },
        "grant_by": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Fecha límite para otorgarlas. Null si aún no hay derecho.",
        },
        "grant_by_mx": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "message": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Aviso fijo del estado. No es un texto capturado.",
        },
        "next_anniversary": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "next_anniversary_mx": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
        },
        "prima_vacacional": {
          "anyOf": [
            {
              "const": "Prima vacacional: no menor al 25% (Art. 80 LFT)",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Texto fijo del artículo 80. Null cuando no hay derecho.",
        },
        "service_years_completed": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": -9007199254740991,
              "type": "integer",
            },
            {
              "type": "null",
            },
          ],
        },
        "state": {
          "enum": [
            "no_hire_date",
            "not_started",
            "before_table",
            "proportional",
            "entitled",
            "closed",
            "error",
          ],
          "type": "string",
        },
        "url": {
          "type": "string",
        },
      },
      "required": [
        "state",
        "message",
        "service_years_completed",
        "current_anniversary",
        "current_anniversary_mx",
        "next_anniversary",
        "next_anniversary_mx",
        "entitlement_days",
        "grant_by",
        "grant_by_mx",
        "prima_vacacional",
        "closed",
        "as_of",
        "as_of_mx",
        "url",
      ],
      "type": "object",
    },
    "title": "Derecho a vacaciones",
  },
  {
    "_meta": {
      "securitySchemes": [
        {
          "scopes": [
            "write:people",
          ],
          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Alta de persona",
    },
    "description": "Da de alta un expediente con las mismas reglas que la app (D-04). RFC, CURP y NSS sólo con el scope pii. CONFLICT si un RFC, CURP o NSS ya es de otra persona activa. Primero responde una vista previa; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "apellido_materno": {
          "maxLength": 120,
          "type": "string",
        },
        "apellido_paterno": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
        "area_id": {
          "description": "Área.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "beneficiarios": {
          "description": "Reemplaza la lista completa; los porcentajes suman 100. Sólo con el scope pii.",
          "items": {
            "properties": {
              "nombre": {
                "maxLength": 160,
                "minLength": 1,
                "type": "string",
              },
              "parentesco": {
                "maxLength": 60,
                "minLength": 1,
                "type": "string",
              },
              "porcentaje": {
                "exclusiveMinimum": 0,
                "maximum": 100,
                "type": "number",
              },
            },
            "required": [
              "nombre",
              "parentesco",
              "porcentaje",
            ],
            "type": "object",
          },
          "maxItems": 10,
          "type": "array",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "curp": {
          "description": "Sólo con el scope pii.",
          "maxLength": 18,
          "type": "string",
        },
        "domicilio_calle": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 160,
          "type": "string",
        },
        "domicilio_codigo_postal": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 5,
          "type": "string",
        },
        "domicilio_colonia": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 120,
          "type": "string",
        },
        "domicilio_estado": {
          "description": "Una de las 32 entidades, p. ej. «Chiapas». Sólo con el scope pii.",
          "maxLength": 60,
          "type": "string",
        },
        "domicilio_municipio": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 120,
          "type": "string",
        },
        "domicilio_numero_exterior": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 20,
          "type": "string",
        },
        "domicilio_numero_interior": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 20,
          "type": "string",
        },
        "email": {
          "format": "email",
          "maxLength": 254,
          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
          "type": "string",
        },
        "estado_civil": {
          "description": "Datos México Sólo con el scope pii.",
          "enum": [
            "soltero",
            "casado",
            "union_libre",
            "divorciado",
            "viudo",
          ],
          "type": "string",
        },
        "fecha_ingreso": {
          "description": "Fecha de ingreso (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "fecha_nacimiento": {
          "description": "Fecha de nacimiento (aaaa-mm-dd).",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "ine_clave_elector": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 20,
          "type": "string",
        },
        "lugar_nacimiento": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 60,
          "type": "string",
        },
        "manager_id": {
          "description": "Jefe directo.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "nacionalidad": {
          "description": "Datos México Sólo con el scope pii.",
          "maxLength": 60,
          "type": "string",
        },
        "nombres": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string",
        },
        "nss": {
          "description": "Sólo con el scope pii.",
          "maxLength": 11,
          "type": "string",
        },
        "position_id": {
          "description": "Puesto.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "rfc": {
          "description": "Sólo con el scope pii.",
          "maxLength": 13,
          "type": "string",
        },
        "sexo": {
          "description": "Datos México Sólo con el scope pii.",
          "enum": [
            "H",
            "M",
          ],
          "type": "string",
        },
        "site_id": {
          "description": "Sucursal o corporativo.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "telefono": {
          "maxLength": 40,
          "type": "string",
        },
      },
      "required": [
        "nombres",
        "apellido_paterno",
        "idempotency_key",
      ],
      "type": "object",
    },
    "name": "create_person",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "audit_event_ids": {
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "code": {
          "const": "CONFIRMATION_REQUIRED",
          "type": "string",
        },
        "confirmation_token": {
          "type": "string",
        },
        "expires_at": {
          "type": "string",
        },
        "expires_at_mx": {
          "type": "string",
        },
        "person": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
            },
            "nombre_completo": {
              "type": "string",
            },
            "status": {
              "type": "string",
            },
            "url": {
              "type": "string",
            },
          },
          "required": [
            "id",
            "nombre_completo",
            "status",
            "url",
          ],
          "type": "object",
        },
        "preview": {
          "additionalProperties": false,
          "properties": {
            "details": {
              "additionalProperties": {},
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "summary": {
              "type": "string",
            },
            "warnings": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
          },
          "required": [
            "summary",
          ],
          "type": "object",
        },
        "status": {
          "description": "preview: nada se escribió todavía; done: el cambio quedó hecho.",
          "enum": [
            "preview",
            "done",
          ],
          "type": "string",
        },
      },
      "required": [
        "status",
      ],
      "type": "object",
    },
    "title": "Alta de persona",
  },
  {
    "_meta": {
      "securitySchemes": [
        {
          "scopes": [
            "write:people",
          ],
          "type": "oauth2",
        },
      ],
    },
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
      "title": "Editar persona",
    },
    "description": "Edita sólo los campos enviados en changes (null borra el dato); el resto del expediente y el horario no cambian. No cambia el estatus (usa set_person_status). RFC, CURP y NSS sólo con el scope pii. Primero responde una vista previa con el antes y después; repite con confirmation_token para hacerlo.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "changes": {
          "additionalProperties": false,
          "description": "Sólo los campos que cambian; null borra el dato. El estatus se cambia con set_person_status.",
          "properties": {
            "apellido_materno": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "apellido_paterno": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string",
            },
            "area_id": {
              "anyOf": [
                {
                  "description": "Área.",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "beneficiarios": {
              "anyOf": [
                {
                  "description": "Reemplaza la lista completa; los porcentajes suman 100.",
                  "items": {
                    "properties": {
                      "nombre": {
                        "maxLength": 160,
                        "minLength": 1,
                        "type": "string",
                      },
                      "parentesco": {
                        "maxLength": 60,
                        "minLength": 1,
                        "type": "string",
                      },
                      "porcentaje": {
                        "exclusiveMinimum": 0,
                        "maximum": 100,
                        "type": "number",
                      },
                    },
                    "required": [
                      "nombre",
                      "parentesco",
                      "porcentaje",
                    ],
                    "type": "object",
                  },
                  "maxItems": 10,
                  "type": "array",
                },
                {
                  "type": "null",
                },
              ],
            },
            "curp": {
              "anyOf": [
                {
                  "maxLength": 18,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_calle": {
              "anyOf": [
                {
                  "maxLength": 160,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_codigo_postal": {
              "anyOf": [
                {
                  "maxLength": 5,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_colonia": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_estado": {
              "anyOf": [
                {
                  "description": "Una de las 32 entidades, p. ej. «Chiapas».",
                  "maxLength": 60,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_municipio": {
              "anyOf": [
                {
                  "maxLength": 120,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_numero_exterior": {
              "anyOf": [
                {
                  "maxLength": 20,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "domicilio_numero_interior": {
              "anyOf": [
                {
                  "maxLength": 20,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "email": {
              "anyOf": [
                {
                  "format": "email",
                  "maxLength": 254,
                  "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "estado_civil": {
              "anyOf": [
                {
                  "enum": [
                    "soltero",
                    "casado",
                    "union_libre",
                    "divorciado",
                    "viudo",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "fecha_ingreso": {
              "anyOf": [
                {
                  "description": "Fecha de ingreso (aaaa-mm-dd).",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "ine_clave_elector": {
              "anyOf": [
                {
                  "maxLength": 20,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "lugar_nacimiento": {
              "anyOf": [
                {
                  "maxLength": 60,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "manager_id": {
              "anyOf": [
                {
                  "description": "Jefe directo.",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "nacionalidad": {
              "anyOf": [
                {
                  "maxLength": 60,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "nombres": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string",
            },
            "nss": {
              "anyOf": [
                {
                  "maxLength": 11,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "position_id": {
              "anyOf": [
                {
                  "description": "Puesto.",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "rfc": {
              "anyOf": [
                {
                  "maxLength": 13,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "sexo": {
              "anyOf": [
                {
                  "enum": [
                    "H",
                    "M",
                  ],
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "site_id": {
              "anyOf": [
                {
                  "description": "Sucursal o corporativo.",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
            "telefono": {
              "anyOf": [
                {
                  "maxLength": 40,
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
            },
          },
          "type": "object",
        },
        "confirmation_token": {
          "description": "Token de la vista previa. Sin él la herramienta sólo muestra qué haría; con él, lo hace. Vence en 10 minutos.",
          "maxLength": 300,
          "type": "string",
        },
        "idempotency_key": {
          "description": "Llave única de esta operación (8–80 caracteres). Repetirla con los mismos datos devuelve el mismo resultado sin duplicar.",
          "maxLength": 80,
          "minLength": 8,
          "type": "string",
        },
        "person_id": {
          "description": "Persona.",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
      },
      "required": [
        "person_id",
        "changes",
        "idempotency_key",
      ],
      "type": "object",
    },
