# PostgreSQL connection string (Neon, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Auth.js — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="your-secret-at-least-32-characters-long"

# Optional Google OAuth (free)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Optional RRHH demo account for production (never commit real values)
# DEMO_RRHH_EMAIL=""
# DEMO_RRHH_PASSWORD=""
# DEMO_RRHH_NAME=""

# Workia MCP connector (docs/mcp-connector.md)
# MCP_ENABLED="0"                       # turns off /api/mcp, /api/oauth/* and /.well-known/*
# MCP_PUBLIC_URL="https://workia.example" # issuer for OAuth metadata (defaults to the request origin)
# MCP_ALLOWED_ORIGINS=""                 # extra browser origins for /api/mcp, comma separated
